+const plainBleedingReport = /^(?:i am experiencing bleeding|i have vaginal bleeding|vaginal bleeding|আমার রক্তপাত হচ্ছে|(?:আমার )?(?:যোনিপথে|যোনি দিয়ে|যোনিপথ দিয়ে) রক্ত (?:যাচ্ছে|পড়ছে))[.!।]?$/u;
