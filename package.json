{
  "name": "prohor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-env.mjs",
    "dev": "next dev",
    "check:env": "node scripts/check-env.mjs",
    "test:env": "node --test tests/config/env-report.test.mjs",
    "test:adapt": "node --test src/features/adapt/lib/*.test.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-database-foundation.mjs",
    "test:db:private-proposal": "node --test tests/database/private-records-proposal.test.mjs",
    "test:db:care-proposal": "node --test tests/database/care-backend-proposal.test.mjs",
    "test:rls": "node scripts/test-rls-sessions.mjs",
    "test:rls:guards": "node --test tests/rls/session-safety.test.mjs",
    "test:pwa:privacy": "node --test tests/rls/public-worker.test.mjs",
    "check:auth-config": "node scripts/check-auth-config.mjs",
    "test:auth-config": "node --test tests/config/auth-config-preflight.test.mjs",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:auth:live": "node scripts/test-auth-live.mjs",
    "test:contracts": "playwright test --config playwright.contracts.config.ts",
    "check:contrast": "node scripts/check-color-contrast.mjs",
    "test:db:onboarding": "node scripts/test-onboarding-single-role.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.460.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
