# Copy to .env.local; never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# No Supabase values: interface runs in clearly labeled DEMO PREVIEW mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Future API integrations must be server-side only.
# NEVER prefix a service-role key or model API secret with NEXT_PUBLIC_ .
