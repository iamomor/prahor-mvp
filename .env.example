# Copy to .env.local; never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Supabase development configuration.
# If unset, interface runs in clearly labeled DEMO PREVIEW mode.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-local-public-key

# Future API integrations must be server-side only.
# NEVER prefix a service-role key or model API secret with NEXT_PUBLIC_ .
