# Copy to .env.local; never commit real secrets. This is the ONLY list of env names the app reads.
# Everyone uses these exact names; do not add per-person alternatives (e.g. AI_API_KEY is not read anywhere).

# --- Required: platform (Omor) ---
# Exact origin of the running app. Every POST route rejects requests without it.
# Local: http://localhost:3000 (127.0.0.1 is a different origin). Staging/prod: the exact https origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xwpdchegbizuswhtqtgc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# --- Barta AI (Iftee). Optional: without these, Barta answers from the approved corpus only. ---
OPENROUTER_API_KEY=
BARTA_OPENROUTER_MODEL=
BARTA_OPENROUTER_FALLBACK_MODEL=
# Dev-only preview of Gemini intent selection (needs PROHOR_BARTA_AI_PREVIEW=1).
GEMINI_API_KEY=
PROHOR_BARTA_GEMINI_MODEL=
PROHOR_BARTA_AI_PREVIEW=

# --- Barta audio (Iftee). Optional; text always works without audio. ---
# Signs audio tickets; any long random string. Required for generated audio.
BARTA_AUDIO_SIGNING_KEY=
BARTA_FISH_AUDIO=
BARTA_FISH_VOICE_BN=
BARTA_FISH_VOICE_EN=
BARTA_AZURE_SPEECH_KEY=
BARTA_AZURE_SPEECH_REGION=
BARTA_ESPEAK_PATH=

# --- Dev-only flags (ignored in production builds) ---
PROHOR_BARTA_DEMO=
PROHOR_BARTA_AI_DEBUG=

# Optional server-only Upstash Redis REST credentials for a shared Barta chat limit.
BARTA_RATE_LIMIT_REDIS_URL=
BARTA_RATE_LIMIT_REDIS_TOKEN=

# --- Optional Cartesia cloud Read Aloud (server-only; never expose to NEXT_PUBLIC) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_EN=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# Set only to a Cartesia voice verified to speak Bengali; otherwise browser speech is used.
CARTESIA_VOICE_ID_BN=9c35520a-73f9-4c9e-b6c6-69027a3819bd
